configuration {
    location:                 0;
    font:                    "Proxima Nova Bold 13";
    display-drun:            "󱄅";
}

* {
    red:                     #DF5B61;
    darkred:                 #f16269;
    green:                   #78B892;
    darkgreen:               #8cd7aa;
    yellow:                  #fab387;
    darkyellow:              #f99c5c;
    blue:                    #6791C9;
    darkblue:                #79aaeb;
    purple:                  #fab387;
    darkpurple:              #f99c5c;
    cyan:                    #67AFC1;
    darkcyan:                #7acfe4;
    foreground:              #D9D7D6;
    background:              #1e1e2e;
    border:                  #fab387;
}

window {
    border:                  2px;
    border-radius:           0px;
    padding:                 30;
    width:                   40%;
    height:                  43%;
    border-color:            @border;
    background-color:        @background;
}

mainbox {
    border:  0;
    padding: 0;
}

message {
    border:        0px 0px 0px;
    border-color: @separatorcolor;
    padding:       1px;
}

textbox {
    text-color: @foreground;
}

listview {
    lines:         15;
    columns:       1;
    fixed-height:  0;
    border:        0px 0px 0px ;
    border-color:  @separatorcolor;
    spacing:       0px;
    scrollbar:     false;
    padding:       2px 0px 0px ;
    background-color: @background;
}

element {
    border:        0;
    padding:       10px; 
}

element normal.normal {
    background-color: @background;
    text-color:       @foreground;
}

element normal.urgent {
    background-color: @red;
    text-color:       @background;
}

element normal.active {
    background-color: @green;
    text-color:       @background;
}

element selected.normal {
    background-color: @yellow;
    border-radius:    10px;
    text-color:       @background;
}

element selected.urgent {
    background-color: @red;
    text-color:       @background;
}

element selected.active {
    background-color: @yellow;
    text-color:       @background;
}

element alternate.normal {
    background-color: @background;
    text-color:       @foreground;
}

element alternate.urgent {
    background-color: @green;
    text-color:       @background;
}

element alternate.active {
    background-color: @green;
    text-color:       @background;
}

element-text {
    cursor:           inherit;
    highlight:        inherit;
    text-color:       inherit;
}

element-icon {
    size:             1.0000em;
    cursor:           inherit;
    text-color:       inherit;
}

scrollbar {
    width:         0px;
    border:        0;
    handle-color: @yellow;
    handle-width: 8px;
    padding:       0;
}

sidebar {
    border:        0px 0px 0px;
    padding:       5px 0 0;
    border-color: @separatorcolor;
}

button {
    spacing:    0;
    background: @background;
    text-color: @foreground;
}

button.selected {
    background-color: @border;
    border-radius:    50px;
    text-color:       @background;
}

case-indicator {
    spacing:    0;
    text-color: @foreground;
}

entry {
    spacing:       10px;
    padding:       10px;
    text-color:    @foreground;
    placeholder:        "Search";
    placeholder-color:  @foreground;
}

textbox-prompt-colon {
    enabled: true;
    str: " 󱄅 ";
    background-color: @background;
    text-color: @yellow; 
    padding: 10px 0px 10px 10px;
    expand: false;
}

inputbar {
    background-color: @background;
    margin:    0px 0px 10px;
    border:         10px;
    border-radius:  0px;
    border-color:   @background;
    children:   [ textbox-prompt-colon, entry, case-indicator ];
}
